# HRMS production — hr.syntrax.co.tz
# Copy to project root on the VPS: cp .env.production.example .env

DEBUG=False
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
ALLOWED_HOSTS=hr.syntrax.co.tz,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://hr.syntrax.co.tz,http://hr.syntrax.co.tz
SECURE_SSL_REDIRECT=False

POSTGRES_DB=hrms_db
POSTGRES_USER=hrms
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

HRMS_PORT=8020
HRMS_PUBLIC_BASE_URL=https://hr.syntrax.co.tz

# Filled by compose from POSTGRES_* / redis service names — overrides below are optional
# DATABASE_URL=postgres://hrms:...@db:5432/hrms_db

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@hr.syntrax.co.tz

# Optional OAuth / AI — set when ready
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GEMINI_API_KEY=
SENTRY_DSN=
